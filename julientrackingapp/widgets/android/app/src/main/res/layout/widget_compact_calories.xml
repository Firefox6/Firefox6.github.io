<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HEUTE"
            android:textColor="@color/widget_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/widget_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/open_calories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="820"
        android:textColor="@color/widget_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calorie_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="kcal offen"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/calorie_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="63"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_primary" />

    <TextView
        android:id="@+id/protein_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Protein 92 / 150 g"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
